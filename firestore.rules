// Merge these SchoolLab match blocks into existing project rules.
// Publishing this file alone can remove access used by other apps in the same Firebase project.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function owner(userId) { return signedIn() && request.auth.uid == userId; }

    match /settings/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /users/{userId} { allow read: if owner(userId) || admin(); allow write: if admin(); }
    match /prework/{userId} {
      allow read: if signedIn() && (resource.data.isPublic == true || owner(userId) || admin());
      allow create: if admin() || (owner(userId) && request.resource.data.ownerId == userId);
      allow update: if admin() || (owner(userId) && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if false;
    }
    match /prds/{userId} {
      allow read: if signedIn() && (resource.data.isPublic == true || owner(userId) || admin());
      allow create: if owner(userId) && request.resource.data.ownerId == userId;
      allow update: if admin() || (owner(userId) && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if false;
    }
    match /projects/{projectId} {
      allow read: if signedIn() && (resource.data.isPublic == true || owner(resource.data.ownerId) || admin());
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if admin() || (owner(resource.data.ownerId) && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if false;
    }
    match /projects/{projectId}/likes/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow update: if false;
    }
    match /projects/{projectId}/comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if admin() || (owner(resource.data.authorId) && request.resource.data.authorId == resource.data.authorId) || (get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid && request.resource.data.authorId == resource.data.authorId);
      allow delete: if false;
    }
    match /prework/{userId}/comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if admin() || (owner(resource.data.authorId) && request.resource.data.authorId == resource.data.authorId) || (owner(userId) && request.resource.data.authorId == resource.data.authorId);
      allow delete: if false;
    }
    match /prds/{userId}/comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if admin() || (owner(resource.data.authorId) && request.resource.data.authorId == resource.data.authorId) || (owner(userId) && request.resource.data.authorId == resource.data.authorId);
      allow delete: if false;
    }
  }
}
