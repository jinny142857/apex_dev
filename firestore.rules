rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function owner(userId) { return signedIn() && request.auth.uid == userId; }

    match /settings/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /users/{userId} { allow read: if owner(userId) || admin(); allow write: if owner(userId) || admin(); }
    match /prework/{userId} { allow read, write: if owner(userId) || admin(); }
    match /prds/{userId} { allow read, write: if owner(userId) || admin(); }
    match /projects/{projectId} {
      allow read: if signedIn() && (resource.data.isPublic == true || owner(resource.data.ownerId) || admin());
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if owner(resource.data.ownerId) || admin();
    }
    match /projects/{projectId}/comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if owner(resource.data.authorId) || admin();
    }
  }
}
